# Postgres. Railway and Render both hand you this string when you add a database.
DATABASE_URL="postgresql://user:pass@localhost:5432/watchlist"

# Change this before deploying anywhere real.
JWT_SECRET="change-me"

# "seed"  -> deterministic offline data. No keys, no internet, repeatable demo.
# "live"  -> Yahoo (free, no key) plus Finnhub if a key is present.
DATA_SOURCE="seed"

# Optional. Only needed so the "two providers disagree" path can be real.
FINNHUB_API_KEY=""

# Seconds between polls of the DISTINCT set of watched symbols.
POLL_SECONDS=60

# Exposes the demo clock endpoints and the bar at the bottom of the UI.
# Leave this false in a real deployment.
DEMO_MODE=true

PORT=3000
